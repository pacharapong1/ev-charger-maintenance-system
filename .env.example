# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API Keys
#
# The first two are PUBLIC. The anon key is protected by Row Level Security, not by
# secrecy, so it is safe to appear in client code. No key of any kind is stored
# in the .sql files in this repository: every value goes through environment
# variables, which is why the SQL schema is identical for every Supabase project.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# SUPABASE_JWT_SECRET  (REQUIRED)
# =============================================================================
# This project implements its own authentication instead of using Supabase Auth.
# On a successful login the server signs a session token with this secret, and the
# Supabase database accepts that same token: PostgREST validates the signature,
# switches the Postgres role to `authenticated`, and exposes the token's `sub`
# claim as auth.uid(). That is what every Row Level Security policy keys off, so
# the policies are unchanged by having our own login form.
#
# Where to find it: Project Settings > API Keys > JWT Secret. It is the legacy
# shared secret and uses HS256. If the page only shows asymmetric signing keys,
# open the "JWT Secret" section to reveal or create the shared one; without a
# shared secret this approach cannot work.
#
# NEVER give this a NEXT_PUBLIC_ prefix. That prefix inlines the value into the
# JavaScript bundle that ships to the browser, where anyone can read it from
# devtools. A leaked signing secret means anyone can mint a token for any account.
SUPABASE_JWT_SECRET=your-projects-shared-jwt-secret

# NEVER put the service_role key in a NEXT_PUBLIC_ variable.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the client bundle and is
# readable by anyone who opens devtools. This project does not use it at all:
# every permission check is done with the anon key plus RLS, so there is no
# reason to have the service_role key anywhere in this app or in .env.local.
#
# If you ever need service_role access from a trusted server, use the
# unprefixed name SUPABASE_SERVICE_ROLE_KEY, keep it in .env.local only, and
# read it exclusively from server code. Never import it into a "use client"
# file or pass it to a client component as a prop.

# =============================================================================
# AI Charging Cable & Module Analyzer (app/api/ai-analyze)
# =============================================================================
# NOTE the missing NEXT_PUBLIC_ prefix. That prefix inlines a value into the
# browser bundle, where anyone can read it from devtools, so an OpenAI key must
# never carry it. The route handler is the only thing that reads this value, and
# the key never reaches the client.
OPENAI_API_KEY=your-key-here

# Optional. Defaults to gpt-4o-mini when unset. Any model that supports the
# json_schema response format will work.
OPENAI_MODEL=gpt-4o-mini
